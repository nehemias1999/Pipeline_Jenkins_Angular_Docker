# Variables del despliegue Angular/Docker (inyectadas via env_file, sin secretos).
# Usage: referenciado por docker/docker-compose.yaml (env_file: ANGULAR_APPLICATION.var).

DOCKER_IMAGE_NAME=angular_application
DOCKER_IMAGE_TAG=1.1
DOCKER_CONTAINER_NAME=angular_application
REMOTE_SERVER_IP=192.0.2.10
NGINX_HOST=localhost
NGINX_PORT=8080
